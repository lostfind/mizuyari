{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client", "svelte"],
    "paths": {
      "$lib/*": ["./src/client/lib/*"],
      "$shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.svelte", "src/shared/**/*.ts"]
}
