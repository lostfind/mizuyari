{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["./worker-configuration.d.ts"],
    "paths": {
      "$shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/worker/**/*.ts", "src/shared/**/*.ts"]
}
