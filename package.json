{
  "name": "mizuyari",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Personal work-management app: biweekly conditioning-meeting reports from GitHub and Google activity.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "check": "pnpm check:worker && pnpm check:client",
    "check:worker": "pnpm cf-typegen && tsc -p tsconfig.worker.json --noEmit",
    "check:client": "svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mizuyari --local",
    "db:migrate:remote": "wrangler d1 migrations apply mizuyari --remote",
    "db:bookmark": "wrangler d1 time-travel info mizuyari",
    "cf-typegen": "wrangler types --include-env=false"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "drizzle-kit": "^0.31.11",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  }
}
